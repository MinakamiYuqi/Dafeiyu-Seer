<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    background: #2b2b2b;
    -webkit-font-smoothing: antialiased;
  }
  .wrap { display: inline-block; background: #f2efe6; }

  /* ── 标题 ── */
  .title {
    padding: 18px 26px 15px;
    background: #7a3b32;
    color: #fdf6ec;
    font-size: 30px;
    font-weight: 800;
    letter-spacing: 1px;
    line-height: 1.25;
  }
  .title .sub {
    display: block;
    margin-top: 7px;
    font-size: 15px;
    font-weight: 400;
    color: #e6cfc2;
    letter-spacing: .5px;
  }

  /* ── 榜单 ── */
  .list { padding: 8px 14px 4px; }

  .row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 8px;
    border-radius: 10px;
  }
  .row:nth-child(odd) { background: #fbf9f3; }
  /* 前三名单独描边 */
  .row.top1 { background: #fff6e0; box-shadow: inset 3px 0 0 #f0b429; }
  .row.top2 { background: #f8f7f2; box-shadow: inset 3px 0 0 #b8b8c0; }
  .row.top3 { background: #fbf4ee; box-shadow: inset 3px 0 0 #cf8a5c; }

  .rank {
    width: 34px;
    text-align: center;
    font-size: 19px;
    font-weight: 800;
    color: #6e6656;
    flex: 0 0 34px;
  }
  .row.top1 .rank { color: #d99a20; }
  .row.top2 .rank { color: #8d8d99; }
  .row.top3 .rank { color: #b3714a; }

  .art {
    width: 52px; height: 52px;
    border-radius: 9px;
    object-fit: cover;
    background: #e2dbca;
    flex: 0 0 52px;
  }
  .art.missing {
    background: repeating-linear-gradient(
      45deg, #ddd6c4, #ddd6c4 5px, #d3cbb6 5px, #d3cbb6 10px);
  }

  .nm {
    flex: 0 0 168px;
    font-size: 16px;
    font-weight: 700;
    color: #3d3529;
    word-break: break-all;
    line-height: 1.2;
  }

  /* 票数条 */
  .bar {
    flex: 1 1 auto;
    height: 20px;
    background: #e7e1d2;
    border-radius: 10px;
    overflow: hidden;
    position: relative;
  }
  .bar > i {
    display: block;
    height: 100%;
    border-radius: 10px;
    background: linear-gradient(90deg, #c9542f, #e8892f);
  }
  .row.top1 .bar > i { background: linear-gradient(90deg, #d99a20, #f0c040); }
  .row.top2 .bar > i { background: linear-gradient(90deg, #8d8d99, #b8b8c0); }
  .row.top3 .bar > i { background: linear-gradient(90deg, #b3714a, #cf8a5c); }

  .sc {
    flex: 0 0 78px;
    text-align: right;
    font-size: 17px;
    font-weight: 800;
    color: #553f2e;
    font-variant-numeric: tabular-nums;
  }
  .sc small { font-size: 12px; font-weight: 600; color: #8a8172; margin-left: 2px; }

  /* 页脚 */
  .footer {
    display: flex;
    justify-content: space-between;
    padding: 10px 22px 14px;
    font-size: 13px;
    color: #8a8172;
  }

  /* 说明条 */
  .note {
    margin: 4px 14px 0;
    padding: 9px 12px;
    background: #efe9da;
    border-left: 3px solid #c9542f;
    border-radius: 6px;
    font-size: 13.5px;
    color: #5c5344;
    line-height: 1.5;
  }
</style>
</head>
<body>
<div class="wrap">
  <div class="title">
    {{ title }}
    {% if subtitle %}<span class="sub">{{ subtitle }}</span>{% endif %}
  </div>

  {% if note %}<div class="note">{{ note }}</div>{% endif %}

  <div class="list">
    {% for r in rows %}
    <div class="row{% if r.rank == 1 %} top1{% elif r.rank == 2 %} top2{% elif r.rank == 3 %} top3{% endif %}">
      <span class="rank">{{ r.rank }}</span>
      {% if r.img %}<img class="art" src="{{ r.img }}" alt="">{% else %}<div class="art missing"></div>{% endif %}
      <span class="nm">{{ r.name }}</span>
      <div class="bar"><i style="width: {{ r.pct }}%"></i></div>
      <span class="sc">{{ r.score }}<small>票</small></span>
    </div>
    {% endfor %}
  </div>

  <div class="footer">
    <span>{{ footer_left }}</span>
    <span>{{ footer_right }}</span>
  </div>
</div>
</body>
</html>
